---
import { siteConfig } from "../../config";
import { hero, portrait } from "../../content";
import Button from "../Button.astro";

const webpSrcset = portrait.widths
  .map((w) => `${portrait.dir}/jake-${w}.webp ${w}w`)
  .join(", ");
const jpegSrcset = portrait.widths
  .map((w) => `${portrait.dir}/jake-${w}.jpg ${w}w`)
  .join(", ");
---

<section id="hero" class="hero" aria-labelledby="hero-name">
  <div class="jr-split hero__inner">
    <div class="hero__copy">
      <span class="hero__eyebrow">{hero.eyebrow}</span>
      <h1 class="hero__name" id="hero-name">Jake<br />Robins</h1>
      <p class="hero__positioning">{hero.positioning}</p>
      <p class="hero__lede">{hero.lede}</p>
      <div class="hero__actions">
        <Button href={siteConfig.socials.email} size="lg" trailingGlyph="→">
          {siteConfig.email}
        </Button>
      </div>
    </div>
    <div class="hero__portrait">
      <picture>
        <source type="image/webp" srcset={webpSrcset} sizes={portrait.sizes} />
        <source type="image/jpeg" srcset={jpegSrcset} sizes={portrait.sizes} />
        <img
          src={portrait.src}
          srcset={jpegSrcset}
          sizes={portrait.sizes}
          alt={portrait.alt}
          width={portrait.width}
          height={portrait.height}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </div>
</section>
