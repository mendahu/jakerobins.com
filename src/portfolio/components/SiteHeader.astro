---
import { siteConfig } from "../config";
import Button from "./Button.astro";
---

<header class="site-header">
  <div class="site-header__bar">
    <!-- Wordmark links home; Contact is the only other control. Full-bleed bar
         so the sticky chrome reaches the viewport edges. -->
    <nav class="site-header__nav" aria-label="Primary">
      <a class="site-header__wordmark" href="/">Jake Robins</a>
      <Button href={siteConfig.socials.email} size="sm" trailingGlyph="→">
        {siteConfig.email}
      </Button>
    </nav>
  </div>
</header>
