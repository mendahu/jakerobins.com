---
import { siteConfig } from "../config";
import Button from "./Button.astro";
---

<header class="site-header">
  <div class="container site-header__bar">
    <!-- The wordmark is the mark; there is no drawn logo and no menu of routes
         that do not exist. Contact is the only control up here. -->
    <span class="site-header__wordmark">Jake Robins</span>
    <Button href={siteConfig.socials.email} size="sm" trailingGlyph="→">
      Email me
    </Button>
  </div>
</header>
