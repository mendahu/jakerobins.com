---
// No imports from src/blog. Funnel UI lives only in src/portfolio/.
import Footer from "../components/Footer.astro";
import Head from "../components/Head/Head.astro";
import {
  defaultHeadConfig,
  type HeadConfig,
} from "../components/Head/headConfig";
import "../css/holding.css";
import GoogleAnalytics from "./GoogleAnalytics.astro";

interface Props {
  headConfig?: HeadConfig;
}

const headConfig: HeadConfig = Astro.props.headConfig || defaultHeadConfig;
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <GoogleAnalytics />
    <Head {...headConfig} />
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
